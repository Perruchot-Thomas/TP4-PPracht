---
import Layout from '../layouts/Layout.astro';
---

<Layout title="TP - Test Simple">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200/60 mb-2">
          <span>TP</span>
          <span>•</span>
          <span>Côté Client</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Test Simple (Alphabet)
        </h1>
      </div>

      <a href="/" class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200/60 transition shadow-sm self-start sm:self-auto">
        <span aria-hidden="true">←</span>
        <span>Retour Accueil</span>
      </a>
    </div>

    <section class="bg-slate-50/50 rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 w-full">
      <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-wider mb-4 border-b border-slate-100 pb-4">Validation d'Observable Plot</h2>
      
      <div id="plot-container" class="overflow-x-auto min-h-[400px]"></div>
      
      <footer class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>Source : Données manuelles</span>
        <span>Graphique en barres</span>
      </footer>
    </section>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";

    const data = [
      { lettre: "A", valeur: 10 },
      { lettre: "B", valeur: 25 },
      { lettre: "C", valeur: 15 }
    ];

    const plotContainer = document.querySelector("#plot-container");
    if (plotContainer) {
      plotContainer.innerHTML = "";
      
      const plot = Plot.plot({
        grid: true,
        inset: 10,
        color: { legend: true },
        marks: [
          Plot.frame({ stroke: "#e2e8f0" }),
          Plot.barY(data, { x: "lettre", y: "valeur", fill: "lettre", tip: true })
        ]
      });
      
      plotContainer.append(plot);
    }
  </script>
</Layout>