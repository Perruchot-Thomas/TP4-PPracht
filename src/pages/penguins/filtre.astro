---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---

<Layout>
  <div class="p-8 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6">Pingouins avec Filtre Interactif</h1>
    
    <div class="mb-6">
      <label for="species" class="font-semibold text-slate-700 mr-2">Filtrer par espèce :</label>
      <select name="species" id="species" class="px-4 py-2 rounded-lg border border-slate-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">All species</option>
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
      </select>
    </div>

    <div id="plot-container" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm min-h-[400px]"></div>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../../assets/penguins.json";

    const selectSpecies = document.querySelector("#species") as HTMLSelectElement;
    const plotContainer = document.querySelector("#plot-container");

    function renderPlot() {
      if (!plotContainer || !selectSpecies) return;

      const species = selectSpecies.value;
      
      plotContainer.innerHTML = "";

      const plot = Plot.plot({
        grid: true,
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
            filter: (d) => species === "" || d.species === species
          }),
        ],
      });
      
      plotContainer.append(plot);
    };
    selectSpecies?.addEventListener("change", renderPlot);
    
    renderPlot();
  </script>
</Layout>