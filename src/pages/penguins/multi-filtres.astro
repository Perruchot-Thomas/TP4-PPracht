---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="TP - Pingouins (Filtres Multiples)">
  <div class="max-w-4xl mx-auto p-8 bg-white rounded-2xl border border-slate-200/80 shadow-sm mt-12 mb-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200/60 mb-2">
          <span>TP</span>
          <span>•</span>
          <span>Côté Client</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Pingouins (Filtres Combinés)
        </h1>
      </div>

      <a href="/" class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200/60 transition shadow-sm self-start sm:self-auto">
        <span aria-hidden="true">←</span>
        <span>Retour Accueil</span>
      </a>
    </div>

    <div class="mb-8 p-6 bg-slate-50/50 rounded-xl border border-slate-200/80 flex flex-wrap gap-6 shadow-sm">
      <div class="flex flex-col gap-2">
        <label for="species" class="text-sm font-semibold text-slate-700">Espèce :</label>
        <select id="species" class="w-40 px-3 py-2 rounded-lg bg-white border border-slate-200 text-slate-800 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Toutes</option>
          <option value="Adelie">Adelie</option>
          <option value="Chinstrap">Chinstrap</option>
          <option value="Gentoo">Gentoo</option>
        </select>
      </div>
      <div class="flex flex-col gap-2">
        <label for="island" class="text-sm font-semibold text-slate-700">Île :</label>
        <select id="island" class="w-40 px-3 py-2 rounded-lg bg-white border border-slate-200 text-slate-800 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Toutes</option>
          <option value="Biscoe">Biscoe</option>
          <option value="Dream">Dream</option>
          <option value="Torgersen">Torgersen</option>
        </select>
      </div>
      <div class="flex flex-col gap-2">
        <label for="sex" class="text-sm font-semibold text-slate-700">Sexe :</label>
        <select id="sex" class="w-40 px-3 py-2 rounded-lg bg-white border border-slate-200 text-slate-800 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Tous</option>
          <option value="MALE">Mâle</option>
          <option value="FEMALE">Femelle</option>
        </select>
      </div>
    </div>

    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 w-full">
      <div id="plot-container" class="overflow-x-auto min-h-[400px]"></div>
      <footer class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>Source : Palmer Station LTER</span>
        <span>Recherche multi-critères</span>
      </footer>
    </section>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../../assets/penguins.json";

    const selectSpecies = document.querySelector("#species") as HTMLSelectElement;
    const selectIsland = document.querySelector("#island") as HTMLSelectElement;
    const selectSex = document.querySelector("#sex") as HTMLSelectElement;
    const plotContainer = document.querySelector("#plot-container");

    function renderPlot() {
      if (!plotContainer) return;
      const species = selectSpecies.value;
      const island = selectIsland.value;
      const sex = selectSex.value;
      
      plotContainer.innerHTML = "";

      const plot = Plot.plot({
        grid: true, inset: 10,
        color: { legend: true },
        marks: [
          Plot.frame({ stroke: "#e2e8f0" }),
          Plot.dot(penguins, {
            x: "culmen_length_mm", y: "culmen_depth_mm", fill: "species", r: 4, tip: true,
            filter: (d) => 
              (species === "" || d.species === species) &&
              (island === "" || d.island === island) &&
              (sex === "" || d.sex === sex)
          })
        ]
      });
      plotContainer.append(plot);
    };

    selectSpecies?.addEventListener("change", renderPlot);
    selectIsland?.addEventListener("change", renderPlot);
    selectSex?.addEventListener("change", renderPlot);
    
    renderPlot();
  </script>
</Layout>