---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pizza avec Filtre">
  <div class="p-8 max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-slate-900">Pizzas avec Filtre Interactif</h1>
      <a href="/" class="text-sm font-semibold px-4 py-2 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition">← Retour</a>
    </div>
    
    <div class="mb-6 bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm">
      <label for="category" class="font-semibold text-slate-700 mr-2">Filtrer par catégorie :</label>
      <select name="category" id="category" class="px-4 py-2 rounded-lg border border-slate-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
        <option value="">Toutes les catégories</option>
        <option value="Classic">Classic</option>
        <option value="Specialty">Specialty</option>
        <option value="Vegetarian">Vegetarian</option>
      </select>
    </div>

    <div id="plot-container" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm min-h-[400px]"></div>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import pizzaData from "../../assets/pizza.json";

    const selectCategory = document.querySelector("#category") as HTMLSelectElement;
    const plotContainer = document.querySelector("#plot-container");

    function renderPlot() {
      if (!plotContainer || !selectCategory) return;

      const category = selectCategory.value;
      plotContainer.innerHTML = "";

      const plot = Plot.plot({
        grid: true,
        inset: 10,
        x: { label: "Prix ($)", domain: [10, 28] },
        y: { label: "Nombre de commandes", domain: [0, 450] },
        marks: [
          Plot.frame({ stroke: "#e2e8f0" }),
          Plot.dot(pizzaData, {
            x: "price",
            y: "orders",
            fill: "category",
            r: 5,
            tip: true,
            filter: (d) => category === "" || d.category === category
          }),
        ],
      });
      
      plotContainer.append(plot);
    };

    selectCategory?.addEventListener("change", renderPlot);
    renderPlot();
  </script>
</Layout>